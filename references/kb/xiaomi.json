        },
        "query": {
          "mode": "xiaomi_api",
          "categories": [
            "小米手机",
            "Redmi手机",
            "智能穿戴及耳机",
            "电脑办公"
          ],
          "pre_wait_ms": 12000,
          "api": {
            "service_api": "https://api2.service.order.mi.com",
            "fetch_mode": "http",
            "concurrency": 8,
            "class_tree": "/repair_price/shop_class_info?keyword=&callback=cb",
            "class_price": "/repair_price/shop_band_wx_price?class_id={class_id}&callback=cb",
            "field_map": {
              "part": "materials[].shop_material_class_name",
              "material_price": "materials[].sale_price",
              "labor_price": "materials[].handwork_cost",
              "note": "总价 = 保外物料指导价 + 保外人工指导价；out_warranty_price 恒为 0，不是物料价，勿用"
            }
          },
          "series_filter": {
            "电脑办公": [
              "平板",
              "Pad"
            ]
          }
        },
        "extract": {
          "header": [
            "备件名称",
            "保外物料指导价（元）",
            "保外人工指导价（元）"
          ],
          "cols": {
            "part": 0,
            "material_price": 1,
            "labor_price": 2
          },
          "note": "DOM 点选路径（xiaomi_material_table）的历史映射，现已弃用；xiaomi_api 按接口字段直取，不再依赖此选择器"
